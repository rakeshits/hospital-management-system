<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0"
         metadata-complete="false">

  <display-name>Hospital Management System – Backend API</display-name>
  <description>
    REST API backend for the Hospital Management System.
    Servlets are registered via @WebServlet annotations; only global
    configuration lives here.
  </description>

  <!-- ═══════════════════════════════════════════════════════════════════════
       SESSION CONFIGURATION
       ═══════════════════════════════════════════════════════════════════════ -->
  <session-config>
    <!-- Session timeout: 60 minutes of inactivity -->
    <session-timeout>60</session-timeout>
    <cookie-config>
      <!-- HttpOnly prevents JavaScript from reading the session cookie -->
      <http-only>true</http-only>
      <!--
        Set secure="true" in production (HTTPS only).
        Keep false for local HTTP development.
      -->
      <secure>false</secure>
      <same-site>Lax</same-site>
    </cookie-config>
    <tracking-mode>COOKIE</tracking-mode>
  </session-config>

  <!-- ═══════════════════════════════════════════════════════════════════════
       WELCOME FILE
       ═══════════════════════════════════════════════════════════════════════ -->
  <welcome-file-list>
    <welcome-file>index.html</welcome-file>
  </welcome-file-list>

  <!-- ═══════════════════════════════════════════════════════════════════════
       GLOBAL ERROR PAGES
       ═══════════════════════════════════════════════════════════════════════ -->
  <error-page>
    <error-code>404</error-code>
    <location>/error/404</location>
  </error-page>
  <error-page>
    <error-code>500</error-code>
    <location>/error/500</location>
  </error-page>

  <!-- ═══════════════════════════════════════════════════════════════════════
       CHARACTER ENCODING FILTER
       Forces UTF-8 for all requests and responses.
       ═══════════════════════════════════════════════════════════════════════ -->
  <filter>
    <filter-name>CharacterEncodingFilter</filter-name>
    <filter-class>jakarta.servlet.http.HttpFilter</filter-class>
    <!-- Tomcat's built-in SetCharacterEncodingFilter -->
    <filter-class>org.apache.catalina.filters.SetCharacterEncodingFilter</filter-class>
    <init-param>
      <param-name>encoding</param-name>
      <param-value>UTF-8</param-value>
    </init-param>
    <init-param>
      <param-name>ignore</param-name>
      <param-value>true</param-value>
    </init-param>
  </filter>
  <filter-mapping>
    <filter-name>CharacterEncodingFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>

  <!--
    NOTE: CORSFilter and all Servlets are registered via annotations
    (@WebFilter, @WebServlet) so no explicit <filter> or <servlet>
    entries are needed here.

    All API endpoints follow the pattern:
      GET    /api/{resource}        → list all
      GET    /api/{resource}?id=N   → get by id
      POST   /api/{resource}        → create
      PUT    /api/{resource}?id=N   → update
      DELETE /api/{resource}?id=N   → delete

    Auth endpoints:
      POST   /api/login             → LoginServlet
      POST   /api/logout            → LoginServlet (DELETE method or separate)
      POST   /api/signup            → SignupServlet

    Dashboard endpoints:
      GET    /api/admin/dashboard   → AdminDashboardServlet
      GET    /api/doctor/dashboard  → DoctorDashboardServlet
      GET    /api/patient/dashboard → PatientDashboardServlet
      GET    /api/staff/dashboard   → StaffDashboardServlet
  -->

</web-app>
